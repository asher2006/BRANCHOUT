# Comma-separated browser origins permitted to call the API in production.
# Leave unset when the frontend is served by this backend.
CORS_ORIGIN=https://your-app.fly.dev

# Optional AI providers. If none are set, Branchout uses its local planner.
GROQ_API_KEY=
GROK_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Local development default. Fly.io sets this to its persistent volume.
DB_PATH=./branchout.db
